# Public web port exposed by Compose.
WEB_PORT=8080

# FastAPI identity and routing.
BACKEND_APP_NAME=LTA Transport Dashboard API
BACKEND_API_PREFIX=/api/v1

# Exact browser origins allowed during local development. Production traffic is
# same-origin through Nginx and does not require a wildcard.
BACKEND_CORS_ORIGINS=["http://localhost:5173"]

# Upstream HTTP client limits.
BACKEND_HTTP_TIMEOUT_SECONDS=15
BACKEND_HTTP_MAX_CONNECTIONS=100
BACKEND_HTTP_MAX_KEEPALIVE_CONNECTIONS=20

# Compose supplies redis://redis:6379/0 to the API. Override this value when
# running the API outside Compose.
BACKEND_REDIS_URL=redis://localhost:6379/0
BACKEND_REDIS_REQUIRED=false
BACKEND_REDIS_TIMEOUT_SECONDS=1

# Shared cache, stale fallback, jitter, and distributed-lock settings.
BACKEND_CACHE_VERSION=v1
BACKEND_CACHE_TTL_SECONDS=120
BACKEND_CACHE_STALE_SECONDS=3600
BACKEND_CACHE_TTL_JITTER_RATIO=0.1
BACKEND_CACHE_LOCK_SECONDS=15
BACKEND_CACHE_LOCK_WAIT_SECONDS=1

# Provider credentials. Leave optional credentials empty only when the
# corresponding provider endpoints are not used.
BACKEND_DATA_GOV_API_KEY=
BACKEND_LTA_API_KEY=
BACKEND_ONEMAP_API_KEY=
BACKEND_ONEMAP_EMAIL=
BACKEND_ONEMAP_EMAIL_PASSWORD=

# Optional frontend override. Leave empty for same-origin /api requests.
VITE_API_BASE_URL=
